extends ../../layouts/default.pug
include ../../mixins/boxhead.pug

block main 
    .container.my-3
        .row 
            .col-12 
                +boxhead("Danh sách sản phẩm")

        .row
            each item in products 
                .col-4.mb-3
                    .product-item
                        .inner-image
                            img(src= ""  alt="ihpone9")
                        .inner-content 
                            h3.inner-title #{item.title} 
                            .inner-price-new #{item.priceNew}
                            .inner-price-old 90$
                            .inner-discount +30%
            