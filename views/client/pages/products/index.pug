extends ../../layouts/default.pug
include ../../mixins/boxhead.pug

block main 
    .container.my-3
        .row 
            .col-12 
                +boxhead("Danh sách sản phẩm")

        .row
            .col-4.mb-3
                .product-item
                    .inner-image
                        img(src="/images/NAM.png", alt="Messi")
                    .inner-content 
                        h3.inner-title M10 
                            .inner-price-new 100$
                            .inner-price-old 70$
                            .inner-discount +30%